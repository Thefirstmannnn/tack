{
  "name": "@tack/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --minify",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test --timeout 20000"
  },
  "dependencies": {
    "@tack/core": "workspace:*",
    "@tack/db": "workspace:*",
    "@tack/realtime-server": "workspace:*",
    "@tack/shared": "workspace:*",
    "ioredis": "^6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tack/realtime-client": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/ws": "^8.18.2",
    "typescript": "5.9.3",
    "ws": "^8.22.0"
  }
}
